<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TELA 1: CONECTAR -->
    <LinearLayout
        android:id="@+id/screenConnect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASSADOR REPLAY"
            android:textColor="#FF1A1A"
            android:textSize="13sp"
            android:letterSpacing="0.18"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Conectar Shizuku"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1A0000"
            android:padding="16dp"
            android:text="COMO CONECTAR:\n\n1. Toque em “ABRIR SHIZUKU” para abrir o aplicativo\n2. Inicie o serviço do Shizuku, se necessário\n3. Autorize o Passador Replay na lista de aplicativos\n4. Volte para cá e toque em “JÁ CONECTEI”\n5. O acesso só será liberado após a verificação da conexão e da permissão"
            android:textColor="#FFCCCC"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#1A0000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <Button
                android:id="@+id/btnConectar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="?attr/selectableItemBackground"
                android:text="ABRIR SHIZUKU"
                android:textColor="#FF1A1A"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FF1A1A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <Button
                android:id="@+id/btnJaConectei"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="?attr/selectableItemBackground"
                android:text="JÁ CONECTEI"
                android:textColor="#000000"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- TELA 2: DIREÇÃO -->
    <LinearLayout
        android:id="@+id/screenDirection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha a direção"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            app:cardBackgroundColor="#1A0000"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <Button
                android:id="@+id/btnMaxToNormal"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:text="FF MAX  ⇒  FF NORMAL"
                android:textColor="#FF1A1A"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1A0000"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <Button
                android:id="@+id/btnNormalToMax"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackground"
                android:text="FF NORMAL  ⇒  FF MAX"
                android:textColor="#FF1A1A"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- TELA 3: TRANSFERÊNCIA -->
    <LinearLayout
        android:id="@+id/screenTransfer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTransferTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FF MAX  →  FF NORMAL"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvVersionNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Normal: —"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvVersionMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max: —"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Verificando..."
            android:textColor="#FF1A1A"
            android:textSize="13sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#0D0000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/logBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnPassar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_primary"
            android:text="PASSAR REPLAY"
            android:textColor="#000000"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btnBypass"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_danger"
            android:text="BYPASS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
